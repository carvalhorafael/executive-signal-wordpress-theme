#: page-coo-as-a-service.php:191
msgid "Esse trabalho exige uma empresa pronta para mudar a forma como executa."
msgstr ""

#: page-coo-as-a-service.php:196
msgid "Pode fazer sentido"
msgstr ""

#: page-coo-as-a-service.php:197
msgid "A empresa já possui uma operação real para transformar."
msgstr ""

#: page-coo-as-a-service.php:199
msgid "O produto foi validado e a empresa vende de forma consistente."
msgstr ""

#: page-coo-as-a-service.php:200
msgid "Existe equipe e alguma estrutura de gestão."
