{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "color": "var(--es-text-primary)",
          "name": "Text primary",
          "slug": "text-primary"
        },
        {
          "color": "var(--es-background)",
          "name": "Background",
          "slug": "background"
        },
        {
          "color": "var(--es-panel)",
          "name": "Panel",
          "slug": "panel"
        },
        {
          "color": "var(--es-accent)",
          "name": "Accent",
          "slug": "accent"
        },
        {
          "color": "var(--es-warning)",
          "name": "Warning",
          "slug": "warning"
        },
        {
          "color": "var(--es-text-tertiary)",
          "name": "Text tertiary",
          "slug": "text-tertiary"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.75rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.5rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "2.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "4rem"
        }
      ],
      "units": ["px", "rem", "%"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "var(--es-font-sans)",
          "name": "Executive Signal Sans",
          "slug": "executive-signal-sans"
        },
        {
          "fontFamily": "var(--es-font-mono)",
          "name": "Executive Signal Mono",
          "slug": "executive-signal-mono"
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "name": "Base",
          "size": "1rem",
          "slug": "base"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "3.5rem",
            "min": "2.25rem"
          },
          "name": "Display",
          "size": "3rem",
          "slug": "display"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--es-background)",
      "text": "var(--es-text-primary)"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--es-font-sans)",
      "fontSize": "1rem",
      "lineHeight": "1.55"
    }
  }
}
