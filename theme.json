{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "color": "var(--es-text-primary)",
          "name": "Text primary",
          "slug": "text-primary"
        },
        {
          "color": "var(--es-background)",
          "name": "Background",
          "slug": "background"
        },
        {
          "color": "var(--es-panel)",
          "name": "Panel",
          "slug": "panel"
        },
        {
          "color": "var(--es-accent)",
          "name": "Accent",
          "slug": "accent"
        },
        {
          "color": "var(--es-warning)",
          "name": "Warning",
          "slug": "warning"
        },
        {
          "color": "var(--es-text-tertiary)",
          "name": "Text tertiary",
          "slug": "text-tertiary"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.75rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.5rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "2.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "4rem"
        }
      ],
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "var(--es-font-sans)",
          "name": "Executive Signal Sans",
          "slug": "executive-signal-sans"
        },
        {
          "fontFamily": "var(--es-font-mono)",
          "name": "Executive Signal Mono",
          "slug": "executive-signal-mono"
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "name": "Base",
          "size": "1rem",
          "slug": "base"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "3.5rem",
            "min": "2.25rem"
          },
          "name": "Display",
          "size": "3rem",
          "slug": "display"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--es-background)",
      "text": "var(--es-text-primary)"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--es-font-sans)",
      "fontSize": "1rem",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--es-accent)"
        },
        "typography": {
          "fontWeight": "var(--es-font-weight-title)"
        },
        "css": "text-decoration-color: color-mix(in srgb, var(--es-accent) 54%, transparent); text-underline-offset: 0.22em;"
      },
      "h2": {
        "color": {
          "text": "var(--es-text-primary)"
        },
        "typography": {
          "fontFamily": "var(--es-font-sans)",
          "fontSize": "clamp(1.75rem, 3vw, 2.5rem)",
          "fontWeight": "var(--es-font-weight-heading)",
          "lineHeight": "1.12"
        },
        "spacing": {
          "margin": {
            "top": "3rem",
            "bottom": "1rem"
          }
        }
      },
      "h3": {
        "color": {
          "text": "var(--es-text-primary)"
        },
        "typography": {
          "fontFamily": "var(--es-font-sans)",
          "fontSize": "clamp(1.35rem, 2vw, 1.75rem)",
          "fontWeight": "var(--es-font-weight-heading)",
          "lineHeight": "1.2"
        },
        "spacing": {
          "margin": {
            "top": "2.25rem",
            "bottom": "0.75rem"
          }
        }
      },
      "h4": {
        "color": {
          "text": "var(--es-text-primary)"
        },
        "typography": {
          "fontFamily": "var(--es-font-sans)",
          "fontSize": "1.125rem",
          "fontWeight": "var(--es-font-weight-heading)",
          "lineHeight": "1.3"
        },
        "spacing": {
          "margin": {
            "top": "1.75rem",
            "bottom": "0.5rem"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--es-text-tertiary)"
        },
        "typography": {
          "fontSize": "0.875rem",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "var(--es-radius-pill)"
        },
        "color": {
          "background": "var(--es-accent)",
          "text": "var(--es-text-inverse)"
        },
        "spacing": {
          "padding": {
            "top": "0.7rem",
            "right": "1rem",
            "bottom": "0.7rem",
            "left": "1rem"
          }
        },
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "var(--es-font-weight-title)",
          "lineHeight": "1.2"
        },
        "css": "text-decoration: none;"
      },
      "core/quote": {
        "border": {
          "color": "color-mix(in srgb, var(--es-accent) 24%, var(--es-border-soft))",
          "radius": "var(--es-radius-panel)",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "color-mix(in srgb, var(--es-accent) 7%, var(--es-panel))",
          "text": "var(--es-text-primary)"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "1.25rem",
            "bottom": "1rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontSize": "clamp(1.25rem, 2vw, 1.5rem)",
          "lineHeight": "1.55"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--es-border-strong)"
        },
        "css": "border: 0; height: 1px; width: min(10rem, 40%);"
      },
      "core/code": {
        "border": {
          "color": "color-mix(in srgb, var(--es-border-soft) 70%, transparent)",
          "radius": "var(--es-radius-panel)",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--es-panel-muted)",
          "text": "var(--es-text-primary)"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "1rem",
            "bottom": "1rem",
            "left": "1rem"
          }
        },
        "typography": {
          "fontFamily": "var(--es-font-mono)",
          "fontSize": "0.9375rem",
          "lineHeight": "1.7"
        },
        "css": "overflow-x: auto;"
      },
      "core/preformatted": {
        "border": {
          "color": "color-mix(in srgb, var(--es-border-soft) 70%, transparent)",
          "radius": "var(--es-radius-panel)",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--es-panel-muted)",
          "text": "var(--es-text-primary)"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "right": "1rem",
            "bottom": "1rem",
            "left": "1rem"
          }
        },
        "typography": {
          "fontFamily": "var(--es-font-mono)",
          "fontSize": "0.9375rem",
          "lineHeight": "1.7"
        },
        "css": "overflow-x: auto; white-space: pre-wrap;"
      },
      "core/pullquote": {
        "border": {
          "color": "color-mix(in srgb, var(--es-accent) 30%, var(--es-border-soft))",
          "style": "solid",
          "width": "1px 0"
        },
        "color": {
          "text": "var(--es-text-primary)"
        },
        "spacing": {
          "padding": {
            "top": "clamp(1.25rem, 4vw, 2rem)",
            "bottom": "clamp(1.25rem, 4vw, 2rem)"
          }
        },
        "typography": {
          "lineHeight": "1.25"
        },
        "css": "text-align: center;"
      }
    }
  }
}
