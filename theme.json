{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "color": "#101820",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#f7f5ef",
          "name": "Canvas",
          "slug": "canvas"
        },
        {
          "color": "#ffffff",
          "name": "Surface",
          "slug": "surface"
        },
        {
          "color": "#0f766e",
          "name": "Signal",
          "slug": "signal"
        },
        {
          "color": "#b45309",
          "name": "Attention",
          "slug": "attention"
        },
        {
          "color": "#64748b",
          "name": "Muted",
          "slug": "muted"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.75rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.5rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "2.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "4rem"
        }
      ],
      "units": ["px", "rem", "%"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Avenir Next, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "Sans",
          "slug": "sans"
        },
        {
          "fontFamily": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, monospace",
          "name": "Mono",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "name": "Base",
          "size": "1rem",
          "slug": "base"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "3.5rem",
            "min": "2.25rem"
          },
          "name": "Display",
          "size": "3rem",
          "slug": "display"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "#f7f5ef",
      "text": "#101820"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "1rem",
      "lineHeight": "1.55"
    }
  }
}
